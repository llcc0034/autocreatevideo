# Docker deployment bootstrap only. Product/runtime values are versioned in the
# database and edited from System Settings; credentials are encrypted there.
AUTOPROMPT_DEPLOYMENT_PROFILE=production
POSTGRES_DB=autoprompt
POSTGRES_USER=autoprompt
POSTGRES_PASSWORD=replace-with-a-url-safe-20-plus-character-random-password
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
AUTOPROMPT_JWT_SIGNING_KEY=replace-with-an-independent-32-byte-or-longer-random-secret
# Keep the AES-256-GCM keyring outside database backups and back it up separately.
AUTOPROMPT_CONFIG_MASTER_KEYS=prod-v1:replace-with-base64url-32-byte-key
AUTOPROMPT_CONFIG_ACTIVE_KEY_ID=prod-v1
DJANGO_ALLOWED_HOSTS=studio.example.invalid,backend
DJANGO_DEBUG=false
CORS_ALLOWED_ORIGINS=https://studio.example.invalid
CSRF_TRUSTED_ORIGINS=https://studio.example.invalid
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
DRF_NUM_PROXIES=2
FRONTEND_PORT=8080

# Host/filesystem and network safety boundaries; these are deliberately not DB values.
COMFYUI_OUTPUT_HOST_DIR=C:/path/to/ComfyUI_windows_portable/ComfyUI/output
COMFYUI_ALLOW_NON_LOOPBACK=true
COMFYUI_EXTRA_ALLOWED_NODE_TYPES=
AI_PROVIDER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
TASK_MAX_CONCURRENT=1
