# This file is the explicit Docker production profile. Copy it to .env, replace
# every placeholder, and terminate TLS in a trusted reverse proxy that connects
# only to the loopback-published FRONTEND_PORT.
AUTOPROMPT_DEPLOYMENT_PROFILE=production
POSTGRES_DB=autoprompt
POSTGRES_USER=autoprompt
POSTGRES_PASSWORD=replace-with-a-url-safe-20-plus-character-random-password
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=studio.example.invalid,backend
DJANGO_DEBUG=false
CORS_ALLOWED_ORIGINS=https://studio.example.invalid
CSRF_TRUSTED_ORIGINS=https://studio.example.invalid
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
FRONTEND_PORT=8080
# Browser ceiling for synchronous single-shot detail expansion. Set 0 to rely
# only on provider/server timeouts; episode expansion remains a durable batch.
VITE_SHOT_DETAIL_DRAFT_TIMEOUT_MS=720000
ALLOW_PUBLIC_REGISTRATION=false
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=600/minute
THROTTLE_REGISTRATION_RATE=5/hour
THROTTLE_ASSET_UPLOAD_RATE=30/hour
DRF_NUM_PROXIES=2
ASSET_UPLOAD_MAX_BYTES=10485760
ASSET_VIDEO_MAX_BYTES=262144000
ASSET_AUDIO_MAX_BYTES=52428800
ASSET_TENANT_QUOTA_BYTES=2147483648
ASSET_IMAGE_MAX_WIDTH=8192
ASSET_IMAGE_MAX_HEIGHT=8192
ASSET_IMAGE_MAX_PIXELS=40000000
MEDIA_SIGNED_URL_MAX_AGE_SECONDS=900
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_CLIENT_ID=autoprompt-studio
COMFYUI_TIMEOUT_SECONDS=30
COMFYUI_ALLOW_NON_LOOPBACK=true
COMFYUI_EXTRA_ALLOWED_NODE_TYPES=
COMFYUI_OUTPUT_HOST_DIR=C:/path/to/ComfyUI_windows_portable/ComfyUI/output
MINIMAX_H3_MODEL=minimax-h3
# Authoritative saved-shot and H3 duration range. Creative-provider duration
# policies must stay inside this range; change both values through configuration.
VIDEO_SHOT_MIN_DURATION_MS=5000
VIDEO_SHOT_MAX_DURATION_MS=15000
# Deterministic mother-script breakdown defaults. Per-shot directives in the
# script override these values; malformed directives produce warnings and use
# these defaults instead of aborting the whole breakdown.
SCRIPT_BREAKDOWN_DEFAULT_SHOT_DURATION_MS=5000
SCRIPT_BREAKDOWN_DEFAULT_FIRST_FRAME_CONTINUITY=false
SCRIPT_BREAKDOWN_DEFAULT_LAST_FRAME_CONTINUITY=false
SCRIPT_BREAKDOWN_AUTO_SPLIT_TRIGGER_CHARS=320
SCRIPT_BREAKDOWN_AUTO_SPLIT_TARGET_CHARS=220
# MiniMax H3's aligned-frame envelope for the configured shot duration range.
H3_MIN_ALIGNED_FRAMES=124
H3_MAX_ALIGNED_FRAMES=362
# H3 prompt optimizer is opt-in. Keep false to guarantee no script/prompt egress.
H3_PROMPT_OPTIMIZER_ENABLED=false
H3_PROMPT_OPTIMIZER_BASE_URL=
H3_PROMPT_OPTIMIZER_API_KEY=
H3_PROMPT_OPTIMIZER_MODEL=MiniMax-M2.7
H3_PROMPT_OPTIMIZER_ALLOW_NON_LOOPBACK=false
H3_PROMPT_OPTIMIZER_TIMEOUT_SECONDS=60
H3_PROMPT_OPTIMIZER_FAILURE_MODE=warn
# block rejects production enqueue while H3 video director fields still need English rewriting.
# warn reports mixed-language director fields without blocking production enqueue.
H3_PROMPT_LANGUAGE_GATE=block
# Shared storyboard review recommendations. Exceeding these values creates a
# visible review issue only; it never truncates or rejects a returned draft.
CREATIVE_REVIEW_RECOMMENDED_TITLE_ZH_CHARS=48
CREATIVE_REVIEW_RECOMMENDED_TITLE_EN_CHARS=72
CREATIVE_REVIEW_RECOMMENDED_NARRATIVE_ZH_CHARS=180
CREATIVE_REVIEW_RECOMMENDED_NARRATIVE_EN_CHARS=1000
CREATIVE_REVIEW_RECOMMENDED_CAMERA_ZH_CHARS=220
CREATIVE_REVIEW_RECOMMENDED_CAMERA_EN_CHARS=320
CREATIVE_REVIEW_RECOMMENDED_ACTION_ZH_CHARS=120
CREATIVE_REVIEW_RECOMMENDED_ACTION_EN_CHARS=1000
CREATIVE_REVIEW_RECOMMENDED_CONTINUITY_ZH_CHARS=160
CREATIVE_REVIEW_RECOMMENDED_CONTINUITY_EN_CHARS=240
CREATIVE_REVIEW_RECOMMENDED_SOUNDSCAPE_ZH_CHARS=120
CREATIVE_REVIEW_RECOMMENDED_SOUNDSCAPE_EN_CHARS=180
CREATIVE_REVIEW_RECOMMENDED_MUSIC_ZH_CHARS=80
CREATIVE_REVIEW_RECOMMENDED_MUSIC_EN_CHARS=120
CREATIVE_REVIEW_MAX_CAMERA_MOVEMENTS=1
CREATIVE_REVIEW_MAX_ACTION_SEQUENCE_MARKERS=4
CREATIVE_REVIEW_MIN_SCRIPT_ACTION_COVERAGE_PERCENT=80
# Optional remote prompt translation/expansion. Keep the API key only in this
# backend deployment secret; selecting DeepSeek sends prompt/project context to
# an external service and failures never fall back silently to local Qwen.
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_MAX_TOKENS=16384
# Creative shot-count recommendations only trigger a user confirmation.
# BATCH_SHOTS is an internal single-batch planning value, never an episode or
# series shot-count ceiling; the requested business total is not clamped.
DEEPSEEK_CREATIVE_MIN_SHOTS=1
DEEPSEEK_CREATIVE_RECOMMENDED_MAX_SHOTS=4
DEEPSEEK_CREATIVE_BATCH_SHOTS=1
DEEPSEEK_CREATIVE_MAX_DIALOGUE_PER_SHOT=2
DEEPSEEK_CREATIVE_MAX_EPISODE_TITLE_CHARS=80
DEEPSEEK_CREATIVE_MAX_DIALOGUE_TEXT_CHARS=240
DEEPSEEK_CREATIVE_MAX_DIALOGUE_DELIVERY_CHARS=100
DEEPSEEK_CREATIVE_MAX_DIALOGUE_DELIVERY_EN_CHARS=150
DEEPSEEK_CREATIVE_MIN_SHOT_DURATION_MS=5000
DEEPSEEK_CREATIVE_MAX_SHOT_DURATION_MS=15000
DEEPSEEK_CREATIVE_OUTPUT_MIN_TOKENS=1024
DEEPSEEK_CREATIVE_OUTPUT_BASE_TOKENS=768
DEEPSEEK_CREATIVE_OUTPUT_TOKENS_PER_SHOT=384
DEEPSEEK_CREATIVE_OUTPUT_TOKENS_PER_DIALOGUE=128
DEEPSEEK_CREATIVE_OUTPUT_DIALOGUE_CHAR_THRESHOLD=32
DEEPSEEK_CREATIVE_MAX_SOURCE_CHARS=24000
DEEPSEEK_CREATIVE_MAX_REGENERATION_CONTEXT_CHARS=96000
DEEPSEEK_CREATIVE_MAX_INPUT_CHARS=120000
DEEPSEEK_CREATIVE_OUTPUT_HEADROOM_PER_SHOT=384
PROMPT_TRANSLATION_DEFAULT_PROVIDER=local_qwen
PROMPT_CREATIVE_DEFAULT_PROVIDER=local_qwen
QWEN_TRANSLATION_ENABLED=true
QWEN_TRANSLATION_MODEL_ID=Qwen/Qwen3-4B-GGUF
QWEN_TRANSLATION_MODEL_DIR=../.runtime/models/Qwen/Qwen3-4B-GGUF
QWEN_TRANSLATION_RUNTIME_SCRIPT=../scripts/qwen_translate_once.py
QWEN_TRANSLATION_RUNTIME_PYTHON=../.runtime/qwen-python/Scripts/python.exe
# Keep CPU as the default. To opt in to CUDA, point this setting (and/or the
# creative runtime below) to ../.runtime/qwen-python-cuda/Scripts/python.exe,
# set the matching device to cuda, then restart after the CUDA smoke test passes.
QWEN_TRANSLATION_DEVICE=cpu
# -1 offloads all supported model layers when device=cuda. CPU ignores this value.
QWEN_GPU_LAYERS=-1
QWEN_TRANSLATION_TIMEOUT_SECONDS=300
QWEN_TRANSLATION_MAX_NEW_TOKENS=768
QWEN_CREATIVE_ENABLED=true
QWEN_CREATIVE_MODEL_ID=Qwen/Qwen3-4B-GGUF
QWEN_CREATIVE_MODEL_DIR=../.runtime/models/Qwen/Qwen3-4B-GGUF
QWEN_CREATIVE_RUNTIME_SCRIPT=../scripts/qwen_translate_once.py
QWEN_CREATIVE_RUNTIME_PYTHON=../.runtime/qwen-python/Scripts/python.exe
QWEN_CREATIVE_DEVICE=cpu
QWEN_CREATIVE_TIMEOUT_SECONDS=900
QWEN_CREATIVE_PROCESS_CLEANUP_GRACE_SECONDS=60
QWEN_CREATIVE_MAX_NEW_TOKENS=3072
QWEN_CREATIVE_CONTEXT_SIZE=8192
QWEN_CREATIVE_MIN_CONTEXT_SIZE=8192
QWEN_CREATIVE_MAX_CONTEXT_SIZE=32768
QWEN_CREATIVE_RESERVED_INPUT_TOKENS=2048
QWEN_CREATIVE_MIN_SHOTS=1
QWEN_CREATIVE_RECOMMENDED_MAX_SHOTS=4
QWEN_CREATIVE_BATCH_SHOTS=4
QWEN_CREATIVE_MAX_DIALOGUE_PER_SHOT=2
QWEN_CREATIVE_MAX_EPISODE_TITLE_CHARS=80
QWEN_CREATIVE_MAX_DIALOGUE_TEXT_CHARS=240
QWEN_CREATIVE_MAX_DIALOGUE_DELIVERY_CHARS=100
QWEN_CREATIVE_MAX_DIALOGUE_DELIVERY_EN_CHARS=150
QWEN_CREATIVE_MIN_SHOT_DURATION_MS=5000
QWEN_CREATIVE_MAX_SHOT_DURATION_MS=15000
QWEN_CREATIVE_OUTPUT_MIN_TOKENS=1024
QWEN_CREATIVE_OUTPUT_BASE_TOKENS=768
QWEN_CREATIVE_OUTPUT_TOKENS_PER_SHOT=384
QWEN_CREATIVE_OUTPUT_TOKENS_PER_DIALOGUE=128
QWEN_CREATIVE_OUTPUT_DIALOGUE_CHAR_THRESHOLD=32
QWEN_CREATIVE_MAX_SOURCE_CHARS=16000
QWEN_CREATIVE_MAX_REGENERATION_CONTEXT_CHARS=16000
QWEN_CREATIVE_MAX_INPUT_CHARS=24000
QWEN_CREATIVE_OUTPUT_HEADROOM_PER_SHOT=0

# Per-shot/episode high-detail expansion. Recommended values only trigger a
# confirmation; they never cap the episode's business shot count.
SHOT_DETAIL_RECOMMENDED_ZH_CHARS=500
SHOT_DETAIL_RECOMMENDED_EN_CHARS=750
SHOT_DETAIL_TRANSPORT_ZH_MAX_CHARS=3000
SHOT_DETAIL_TRANSPORT_EN_MAX_CHARS=4500
SHOT_DETAIL_OUTPUT_TOKENS=2304
SHOT_DETAIL_CONTEXT_MAX_CHARS=18000
SHOT_DETAIL_REVIEW_MIN_ZH_CHARS=100
SHOT_DETAIL_REVIEW_MIN_EN_CHARS=160
SHOT_DETAIL_REVIEW_NEAR_ZH_MARGIN_CHARS=20
SHOT_DETAIL_REVIEW_NEAR_EN_MARGIN_CHARS=30
SHOT_DETAIL_MAX_GENERATION_NUMBER=1000000
SHOT_DETAIL_MAX_ATTEMPTS=3
SHOT_DETAIL_RETRY_SECONDS=5
SHOT_DETAIL_STALE_MINUTES=30
SHOT_DETAIL_LEASE_SAFETY_SECONDS=60
QWEN_SHOT_DETAIL_RECOMMENDED_MAX_SHOTS=4
QWEN_SHOT_DETAIL_OUTPUT_TOKENS=2304
QWEN_SHOT_DETAIL_CONTEXT_MAX_CHARS=18000
# Provider-specific high-detail request envelopes. These are validation limits,
# not episode/series shot-count caps; restart API and workers after changing them.
QWEN_SHOT_DETAIL_PROJECT_TITLE_MAX_CHARS=200
QWEN_SHOT_DETAIL_PROJECT_LOGLINE_MAX_CHARS=2000
QWEN_SHOT_DETAIL_PROJECT_CONTINUITY_SUMMARY_MAX_CHARS=3000
QWEN_SHOT_DETAIL_PROJECT_COLOR_SCRIPT_MAX_CHARS=2000
QWEN_SHOT_DETAIL_PROJECT_ASPECT_RATIO_MAX_CHARS=16
QWEN_SHOT_DETAIL_STYLE_MAX_CHARS=8000
QWEN_SHOT_DETAIL_GLOSSARY_MAX_TERMS=200
QWEN_SHOT_DETAIL_GLOSSARY_SOURCE_MAX_CHARS=160
QWEN_SHOT_DETAIL_GLOSSARY_TARGET_MAX_CHARS=240
QWEN_SHOT_DETAIL_REFERENCE_BINDINGS_MAX_CHARS=4000
QWEN_SHOT_DETAIL_SHOT_TITLE_MAX_CHARS=200
QWEN_SHOT_DETAIL_SHOT_NARRATIVE_MAX_CHARS=2000
QWEN_SHOT_DETAIL_SHOT_DETAILED_DESCRIPTION_MAX_CHARS=3500
QWEN_SHOT_DETAIL_SHOT_CAMERA_MAX_CHARS=1000
QWEN_SHOT_DETAIL_SHOT_CONTINUITY_NOTES_MAX_CHARS=1000
QWEN_SHOT_DETAIL_TARGET_ACTION_MAX_CHARS=2000
QWEN_SHOT_DETAIL_TARGET_SOUND_EFFECTS_MAX_CHARS=1000
QWEN_SHOT_DETAIL_TARGET_MUSIC_MAX_CHARS=1000
QWEN_SHOT_DETAIL_TARGET_H3_MODE_MAX_CHARS=16
QWEN_SHOT_DETAIL_DIALOGUE_SPEAKER_ID_MAX_CHARS=16
QWEN_SHOT_DETAIL_DIALOGUE_TEXT_MAX_CHARS=240
QWEN_SHOT_DETAIL_DIALOGUE_DELIVERY_MAX_CHARS=160
QWEN_SHOT_DETAIL_MAX_DIALOGUE_PER_SHOT=2
QWEN_SHOT_DETAIL_BIBLE_MAX_CHARACTERS=20
QWEN_SHOT_DETAIL_BIBLE_MAX_SCENES=1
QWEN_SHOT_DETAIL_BIBLE_MAX_PROPS=30
QWEN_SHOT_DETAIL_BIBLE_SPEAKER_ID_MAX_CHARS=16
QWEN_SHOT_DETAIL_BIBLE_ENTITY_FIELD_MAX_CHARS=2000
QWEN_SHOT_DETAIL_FEEDBACK_MAX_CHARS=2000
DEEPSEEK_SHOT_DETAIL_RECOMMENDED_MAX_SHOTS=16
DEEPSEEK_SHOT_DETAIL_OUTPUT_TOKENS=2304
DEEPSEEK_SHOT_DETAIL_CONTEXT_MAX_CHARS=18000
DEEPSEEK_SHOT_DETAIL_PROJECT_TITLE_MAX_CHARS=200
DEEPSEEK_SHOT_DETAIL_PROJECT_LOGLINE_MAX_CHARS=2000
DEEPSEEK_SHOT_DETAIL_PROJECT_CONTINUITY_SUMMARY_MAX_CHARS=3000
DEEPSEEK_SHOT_DETAIL_PROJECT_COLOR_SCRIPT_MAX_CHARS=2000
DEEPSEEK_SHOT_DETAIL_PROJECT_ASPECT_RATIO_MAX_CHARS=16
DEEPSEEK_SHOT_DETAIL_STYLE_MAX_CHARS=8000
DEEPSEEK_SHOT_DETAIL_GLOSSARY_MAX_TERMS=200
DEEPSEEK_SHOT_DETAIL_GLOSSARY_SOURCE_MAX_CHARS=160
DEEPSEEK_SHOT_DETAIL_GLOSSARY_TARGET_MAX_CHARS=240
DEEPSEEK_SHOT_DETAIL_REFERENCE_BINDINGS_MAX_CHARS=4000
DEEPSEEK_SHOT_DETAIL_SHOT_TITLE_MAX_CHARS=200
DEEPSEEK_SHOT_DETAIL_SHOT_NARRATIVE_MAX_CHARS=2000
DEEPSEEK_SHOT_DETAIL_SHOT_DETAILED_DESCRIPTION_MAX_CHARS=3500
DEEPSEEK_SHOT_DETAIL_SHOT_CAMERA_MAX_CHARS=1000
DEEPSEEK_SHOT_DETAIL_SHOT_CONTINUITY_NOTES_MAX_CHARS=1000
DEEPSEEK_SHOT_DETAIL_TARGET_ACTION_MAX_CHARS=2000
DEEPSEEK_SHOT_DETAIL_TARGET_SOUND_EFFECTS_MAX_CHARS=1000
DEEPSEEK_SHOT_DETAIL_TARGET_MUSIC_MAX_CHARS=1000
DEEPSEEK_SHOT_DETAIL_TARGET_H3_MODE_MAX_CHARS=16
DEEPSEEK_SHOT_DETAIL_DIALOGUE_SPEAKER_ID_MAX_CHARS=16
DEEPSEEK_SHOT_DETAIL_DIALOGUE_TEXT_MAX_CHARS=240
DEEPSEEK_SHOT_DETAIL_DIALOGUE_DELIVERY_MAX_CHARS=160
DEEPSEEK_SHOT_DETAIL_MAX_DIALOGUE_PER_SHOT=2
DEEPSEEK_SHOT_DETAIL_BIBLE_MAX_CHARACTERS=20
DEEPSEEK_SHOT_DETAIL_BIBLE_MAX_SCENES=1
DEEPSEEK_SHOT_DETAIL_BIBLE_MAX_PROPS=30
DEEPSEEK_SHOT_DETAIL_BIBLE_SPEAKER_ID_MAX_CHARS=16
DEEPSEEK_SHOT_DETAIL_BIBLE_ENTITY_FIELD_MAX_CHARS=2000
DEEPSEEK_SHOT_DETAIL_FEEDBACK_MAX_CHARS=2000
# Shared by Django local-Qwen requests and the ComfyUI generation worker.
LOCAL_QWEN_LOCK_PATH=../.runtime/locks/local-qwen.lock
TASK_MAX_CONCURRENT=1
# Queue guidance only: exceeding either recommendation requires explicit user
# confirmation but never truncates the requested episode/shot/task scope.
TASK_RECOMMENDED_MAX_PENDING=20
TASK_RECOMMENDED_MAX_ACTIVE_PER_USER=5
SCRIPT_BREAKDOWN_MAX_SOURCE_CHARS=1000000
TASK_GENERATION_TIMEOUT_SECONDS=21600
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
READINESS_WORKER_MAX_AGE_SECONDS=30
READINESS_MIN_DISK_FREE_BYTES=536870912
READINESS_COMFYUI_REQUIRED=true
READINESS_COMFYUI_TIMEOUT_SECONDS=2
READINESS_GENERATION_WORKER_REQUIRED=true
READINESS_ASSEMBLY_WORKER_REQUIRED=true
ASSEMBLY_TIMEOUT_SECONDS=7200
ASSEMBLY_WORKER_POLL_SECONDS=1
ASSEMBLY_HEARTBEAT_SECONDS=5
ASSEMBLY_STALE_MINUTES=30
ASSEMBLY_RECOVERY_INTERVAL_SECONDS=60
ASSEMBLY_AI_LABEL_ENABLED=true
ASSEMBLY_AI_LABEL_TEXT=AI-generated · MiniMax H3
# Windows can auto-detect a system font. Set an absolute in-container path for minimal Linux images.
ASSEMBLY_AI_LABEL_FONTFILE=
TASK_DISTRIBUTION_ENABLED=true
TASK_DISTRIBUTION_LABEL_TEXT=AI-generated · MiniMax H3
TASK_IMAGE_DISTRIBUTION_LABEL_TEXT=AI-generated · SDXL 1.0
# Optional explicit TrueType/OpenType font. When empty, the service searches a
# short audited list of Windows/Noto/DejaVu fonts and fails visibly if none exist.
TASK_DISTRIBUTION_FONTFILE=
TASK_DISTRIBUTION_VERSION=shot-public-v1
TASK_DISTRIBUTION_TIMEOUT_SECONDS=100
TASK_DISTRIBUTION_LOCK_STALE_SECONDS=180
FFPROBE_BINARY=ffprobe
