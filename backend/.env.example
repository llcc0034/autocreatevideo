# Translation, creative generation and the ComfyUI worker share one OS-visible
# nonblocking memory lease. Every process must resolve this to the same file.
LOCAL_QWEN_LOCK_PATH=../.runtime/locks/local-qwen.lock
TASK_WORKER_POLL_SECONDS=2
TASK_MAX_CONCURRENT=1
# Guidance only: requests above these values require explicit confirmation but
# retain the full business episode/shot volume.
TASK_RECOMMENDED_MAX_PENDING=20
TASK_RECOMMENDED_MAX_ACTIVE_PER_USER=5
SCRIPT_BREAKDOWN_MAX_SOURCE_CHARS=1000000
TASK_GENERATION_TIMEOUT_SECONDS=21600
TASK_REMOTE_POLL_SECONDS=1
TASK_HEARTBEAT_SECONDS=5
TASK_PROGRESS_WEBSOCKET_ENABLED=true
TASK_HEALTH_CHECK_INTERVAL_SECONDS=5
TASK_HEALTH_FAILURE_LIMIT=3
TASK_REMOTE_MISSING_GRACE_SECONDS=5
TASK_CANCEL_GRACE_SECONDS=30
TASK_STALL_THRESHOLD_SECONDS=30
TASK_STALE_RECOVERY_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
READINESS_WORKER_MAX_AGE_SECONDS=30
READINESS_MIN_DISK_FREE_BYTES=536870912
READINESS_COMFYUI_REQUIRED=true
READINESS_COMFYUI_TIMEOUT_SECONDS=2
READINESS_GENERATION_WORKER_REQUIRED=true
READINESS_ASSEMBLY_WORKER_REQUIRED=true
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
ASSEMBLY_TIMEOUT_SECONDS=7200
ASSEMBLY_WORKER_POLL_SECONDS=1
ASSEMBLY_HEARTBEAT_SECONDS=5
ASSEMBLY_STALE_MINUTES=30
ASSEMBLY_RECOVERY_INTERVAL_SECONDS=60
ASSEMBLY_AI_LABEL_ENABLED=true
ASSEMBLY_AI_LABEL_TEXT=AI-generated · MiniMax H3
# Windows auto-detects a system font; minimal Linux images should set an existing absolute path.
ASSEMBLY_AI_LABEL_FONTFILE=
TASK_DISTRIBUTION_ENABLED=true
TASK_DISTRIBUTION_LABEL_TEXT=AI-generated · MiniMax H3
TASK_IMAGE_DISTRIBUTION_LABEL_TEXT=AI-generated · SDXL 1.0
