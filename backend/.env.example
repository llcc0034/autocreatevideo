AUTOPROMPT_DEPLOYMENT_PROFILE=development
DJANGO_SECRET_KEY=setup-generates-a-unique-384-bit-secret-replace-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Local development only. Production must use PostgreSQL. These options make
# concurrent API/worker writes wait rather than fail immediately.
SQLITE_BUSY_TIMEOUT_SECONDS=30
SQLITE_TRANSACTION_MODE=IMMEDIATE
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
ALLOW_PUBLIC_REGISTRATION=false
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=600/minute
THROTTLE_REGISTRATION_RATE=5/hour
THROTTLE_ASSET_UPLOAD_RATE=30/hour
DRF_NUM_PROXIES=0
ASSET_UPLOAD_MAX_BYTES=10485760
ASSET_VIDEO_MAX_BYTES=262144000
ASSET_AUDIO_MAX_BYTES=52428800
ASSET_TENANT_QUOTA_BYTES=2147483648
ASSET_IMAGE_MAX_WIDTH=8192
ASSET_IMAGE_MAX_HEIGHT=8192
ASSET_IMAGE_MAX_PIXELS=40000000
MEDIA_SIGNED_URL_MAX_AGE_SECONDS=900
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=autoprompt-studio
COMFYUI_TIMEOUT_SECONDS=30
COMFYUI_ALLOW_NON_LOOPBACK=false
COMFYUI_EXTRA_ALLOWED_NODE_TYPES=
COMFYUI_OUTPUT_DIR=C:/path/to/ComfyUI_windows_portable/ComfyUI/output
SERVE_ASSETS_WITH_DJANGO=false
MINIMAX_H3_MODEL=minimax-h3
# Optional H3 director-prose optimizer. Disabled means zero prompt egress.
# Local OpenAI-compatible example: http://127.0.0.1:11434/v1 (API key may stay blank).
# Remote providers require HTTPS, an API key, and explicit non-loopback consent.
H3_PROMPT_OPTIMIZER_ENABLED=false
H3_PROMPT_OPTIMIZER_BASE_URL=
H3_PROMPT_OPTIMIZER_API_KEY=
H3_PROMPT_OPTIMIZER_MODEL=MiniMax-M2.7
H3_PROMPT_OPTIMIZER_ALLOW_NON_LOOPBACK=false
H3_PROMPT_OPTIMIZER_TIMEOUT_SECONDS=60
# warn keeps the deterministic source prompt with an honest quality warning;
# block refuses to create a mixed/unvalidated prompt artifact.
H3_PROMPT_OPTIMIZER_FAILURE_MODE=warn
# block rejects production enqueue while H3 video director fields still need English rewriting.
# warn reports mixed-language director fields without blocking production enqueue.
H3_PROMPT_LANGUAGE_GATE=block
# Optional external DeepSeek channel. The API key is a backend-only secret.
# Selecting it sends the prompt and required project context to DeepSeek; an
# API failure is reported to the user and never silently falls back to Qwen.
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_MAX_TOKENS=4096
# Defaults remain local. Users may still choose either provider per operation.
PROMPT_TRANSLATION_DEFAULT_PROVIDER=local_qwen
PROMPT_CREATIVE_DEFAULT_PROVIDER=local_qwen
# Local, review-gated translation. Qwen-MT itself is currently a cloud API;
# the bundled downloader uses an open-weight Qwen3 GGUF checkpoint from
# ModelScope. CPU remains the safe default and keeps ComfyUI's GPU memory free.
# CUDA is opt-in through a separate verified qwen-python-cuda runtime; it is
# rejected rather than silently falling back to CPU when its smoke test fails.
QWEN_TRANSLATION_ENABLED=true
QWEN_TRANSLATION_MODEL_ID=Qwen/Qwen3-4B-GGUF
QWEN_TRANSLATION_MODEL_DIR=../.runtime/models/Qwen/Qwen3-4B-GGUF
QWEN_TRANSLATION_RUNTIME_SCRIPT=../scripts/qwen_translate_once.py
QWEN_TRANSLATION_RUNTIME_PYTHON=../.runtime/qwen-python/Scripts/python.exe
QWEN_TRANSLATION_DEVICE=cpu
# -1 offloads all supported layers only when device=cuda; CPU always uses zero.
QWEN_GPU_LAYERS=-1
QWEN_TRANSLATION_TIMEOUT_SECONDS=300
QWEN_TRANSLATION_MAX_NEW_TOKENS=768
# Structured bilingual storyboard proposals use the same verified GGUF and
# disposable runtime, but have their own safe context/output budget. Keep the
# explicit CPU path until the independent CUDA runtime has passed its smoke test.
QWEN_CREATIVE_ENABLED=true
QWEN_CREATIVE_MODEL_ID=Qwen/Qwen3-4B-GGUF
QWEN_CREATIVE_MODEL_DIR=../.runtime/models/Qwen/Qwen3-4B-GGUF
QWEN_CREATIVE_RUNTIME_SCRIPT=../scripts/qwen_translate_once.py
QWEN_CREATIVE_RUNTIME_PYTHON=../.runtime/qwen-python/Scripts/python.exe
QWEN_CREATIVE_DEVICE=cpu
QWEN_CREATIVE_TIMEOUT_SECONDS=900
QWEN_CREATIVE_MAX_NEW_TOKENS=3072
QWEN_CREATIVE_CONTEXT_SIZE=8192
QWEN_CREATIVE_MAX_SHOTS=4
QWEN_CREATIVE_MAX_SOURCE_CHARS=16000
# Translation, creative generation and the ComfyUI worker share one OS-visible
# nonblocking memory lease. Every process must resolve this to the same file.
LOCAL_QWEN_LOCK_PATH=../.runtime/locks/local-qwen.lock
TASK_WORKER_POLL_SECONDS=2
TASK_MAX_CONCURRENT=1
TASK_MAX_PENDING=20
TASK_MAX_ACTIVE_PER_USER=5
TASK_GENERATION_TIMEOUT_SECONDS=21600
TASK_REMOTE_POLL_SECONDS=1
TASK_HEARTBEAT_SECONDS=5
TASK_PROGRESS_WEBSOCKET_ENABLED=true
TASK_HEALTH_CHECK_INTERVAL_SECONDS=5
TASK_HEALTH_FAILURE_LIMIT=3
TASK_REMOTE_MISSING_GRACE_SECONDS=5
TASK_CANCEL_GRACE_SECONDS=30
TASK_STALL_THRESHOLD_SECONDS=30
TASK_STALE_RECOVERY_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
READINESS_WORKER_MAX_AGE_SECONDS=30
READINESS_MIN_DISK_FREE_BYTES=536870912
READINESS_COMFYUI_REQUIRED=true
READINESS_COMFYUI_TIMEOUT_SECONDS=2
READINESS_GENERATION_WORKER_REQUIRED=true
READINESS_ASSEMBLY_WORKER_REQUIRED=true
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
ASSEMBLY_TIMEOUT_SECONDS=7200
ASSEMBLY_WORKER_POLL_SECONDS=1
ASSEMBLY_HEARTBEAT_SECONDS=5
ASSEMBLY_STALE_MINUTES=30
ASSEMBLY_RECOVERY_INTERVAL_SECONDS=60
ASSEMBLY_AI_LABEL_ENABLED=true
ASSEMBLY_AI_LABEL_TEXT=AI-generated · MiniMax H3
# Windows auto-detects a system font; minimal Linux images should set an existing absolute path.
ASSEMBLY_AI_LABEL_FONTFILE=
TASK_DISTRIBUTION_ENABLED=true
TASK_DISTRIBUTION_LABEL_TEXT=AI-generated · MiniMax H3
TASK_IMAGE_DISTRIBUTION_LABEL_TEXT=AI-generated · SDXL 1.0
TASK_DISTRIBUTION_FONTFILE=
TASK_DISTRIBUTION_VERSION=shot-public-v1
TASK_DISTRIBUTION_TIMEOUT_SECONDS=100
TASK_DISTRIBUTION_LOCK_STALE_SECONDS=180
