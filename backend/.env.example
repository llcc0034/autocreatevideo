# Deployment/bootstrap values only. Business defaults, limits, routes and
# credentials are managed by the database-backed System Settings UI.
AUTOPROMPT_DEPLOYMENT_PROFILE=development
DJANGO_SECRET_KEY=setup-generates-a-unique-384-bit-secret-replace-for-production
AUTOPROMPT_JWT_SIGNING_KEY=setup-generates-an-independent-384-bit-secret
# Keep this AES-256-GCM keyring outside database backups. setup.ps1 generates it.
AUTOPROMPT_CONFIG_MASTER_KEYS=local-v1:replace-with-base64url-32-byte-key
AUTOPROMPT_CONFIG_ACTIVE_KEY_ID=local-v1
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
SQLITE_BUSY_TIMEOUT_SECONDS=30
SQLITE_TRANSACTION_MODE=IMMEDIATE
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
DRF_NUM_PROXIES=0

# Host/filesystem and execution safety boundaries; these cannot depend on the DB.
COMFYUI_ALLOW_NON_LOOPBACK=false
COMFYUI_EXTRA_ALLOWED_NODE_TYPES=
COMFYUI_OUTPUT_DIR=C:/path/to/ComfyUI_windows_portable/ComfyUI/output
AI_PROVIDER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
SERVE_ASSETS_WITH_DJANGO=false
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
ASSEMBLY_AI_LABEL_FONTFILE=
LOCAL_QWEN_LOCK_PATH=../.runtime/locks/local-qwen.lock
TASK_MAX_CONCURRENT=1
