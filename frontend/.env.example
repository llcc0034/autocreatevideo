VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=false
# Synchronous single-shot expansion request ceiling in milliseconds. Use 0 to
# defer entirely to the server/provider timeout; episode expansion is durable.
VITE_SHOT_DETAIL_DRAFT_TIMEOUT_MS=720000

# Used only when VITE_USE_MOCK=true. Keep mock guidance explicit and editable;
# production UI reads the authenticated capability endpoints instead.
VITE_MOCK_CREATIVE_MIN_SHOTS=1
VITE_MOCK_CREATIVE_DEFAULT_SHOTS=4
VITE_MOCK_CREATIVE_RECOMMENDED_MAX_SHOTS=4
VITE_MOCK_CREATIVE_BATCH_SHOTS=4
VITE_MOCK_CREATIVE_MAX_DIALOGUE_PER_SHOT=2
VITE_MOCK_CREATIVE_MAX_SOURCE_CHARS=16000
VITE_MOCK_CREATIVE_MIN_SHOT_DURATION_MS=5000
VITE_MOCK_CREATIVE_MAX_SHOT_DURATION_MS=15000
VITE_MOCK_CREATIVE_BASELINE_MAX_NEW_TOKENS=2304
VITE_MOCK_CREATIVE_MAX_NEW_TOKENS=3072
VITE_MOCK_CREATIVE_CONTEXT_SIZE=8192
VITE_MOCK_CREATIVE_RUNTIME_TIMEOUT_SECONDS=900
VITE_MOCK_CREATIVE_PROCESS_TIMEOUT_SECONDS=960
VITE_MOCK_PRODUCTION_RECOMMENDED_MAX_PENDING=20
VITE_MOCK_PRODUCTION_RECOMMENDED_MAX_ACTIVE_PER_USER=5
VITE_MOCK_PRODUCTION_MAX_CONCURRENT=1
VITE_MOCK_PRODUCTION_TASK_TIMEOUT_SECONDS=21600
VITE_MOCK_VIDEO_SHOT_MIN_DURATION_MS=5000
VITE_MOCK_VIDEO_SHOT_MAX_DURATION_MS=15000
VITE_MOCK_SCRIPT_BREAKDOWN_DEFAULT_SHOT_DURATION_MS=5000
VITE_MOCK_SCRIPT_BREAKDOWN_DEFAULT_FIRST_FRAME_CONTINUITY=false
VITE_MOCK_SCRIPT_BREAKDOWN_DEFAULT_LAST_FRAME_CONTINUITY=false
VITE_MOCK_SCRIPT_BREAKDOWN_AUTO_SPLIT_TRIGGER_CHARS=320
VITE_MOCK_SCRIPT_BREAKDOWN_AUTO_SPLIT_TARGET_CHARS=220
