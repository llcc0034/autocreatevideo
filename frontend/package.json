{
  "name": "cineforge-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:shot-detail-field": "node --test tests/shotDetailedDescription.test.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "test:adapters": "node --test tests/backendAdapters.test.ts",
    "test:dialogue": "node --test tests/dialogue.test.ts",
    "test:translations": "node --test tests/translationReview.test.ts",
    "test:bible-images": "node --test tests/bibleImageCandidates.test.ts",
    "test:deferred-generation": "node --test tests/deferredGeneration.test.ts",
    "test:manual": "node --test tests/productionManual.test.ts",
    "docs:settings-guide": "node scripts/render-system-settings-guide.mjs",
    "test:settings-guide": "node scripts/render-system-settings-guide.mjs --check && node --test tests/systemSettingsGuide.test.ts",
    "test:workflow-selection": "node --test tests/productionWorkflowSelection.test.ts",
    "test:workflow-inputs": "node --test --test-concurrency=1 tests/workflowExecutionInputs.test.ts tests/workflowAssetGroups.test.ts tests/workflowSmokeFixturePresentation.test.ts",
    "test:saved-workflow-import": "node --test --test-concurrency=1 tests/savedWorkflowImport.test.ts tests/workflowProjectorDefinition.test.ts",
    "test:task-grouping": "node --test tests/taskGrouping.test.ts",
    "test:projects": "node --test tests/projectManagement.test.ts",
    "test:assets": "node --test tests/assetManagement.test.ts tests/referenceVideoAssets.test.ts",
    "test:platform": "node --test tests/platformFoundation.test.ts tests/registryDeletion.test.ts tests/executionMonitoring.test.ts tests/productionRecipeFlow.test.ts tests/acceptanceSmokeCenter.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
